{
  "trailingSlash": true,
  "redirects": [
    { "source": "/terms.html", "destination": "/terms-and-conditions/", "permanent": true },
    { "source": "/contact.html", "destination": "/contact/", "permanent": true },
    { "source": "/disclaimer.html", "destination": "/disclaimer/", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/affiliate-disclosure.html", "destination": "/affiliate-disclosure/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
